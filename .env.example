# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (empieza con sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# SECRETO. Solo en el servidor (límite de intentos de inicio de sesión).
# Supabase > Project Settings > API Keys > Secret keys (empieza con sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# SECRETO. Solo para tu computadora: aplicar migraciones y correr pruebas de permisos.
# Supabase > botón "Connect" > Session pooler. Reemplaza [YOUR-PASSWORD] por la contraseña
# de la base de datos. Nunca la pegues en chats ni la subas a GitHub.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
